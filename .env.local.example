# Copy this file to .env.local for local development (never commit .env.local
# itself -- it's already covered by .gitignore's ".env*" rule).
#
# In production (Vercel), set these same three values under
# Project -> Settings -> Environment Variables instead of a file.

# Generate with: npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=

# From a GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:            https://<your-vercel-domain>
#   Authorization callback:  https://<your-vercel-domain>/api/auth/callback/github
# For local dev, register a SEPARATE OAuth App with:
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# From a Google OAuth Client: https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Web application
#   Authorized redirect URI (prod):   https://<your-vercel-domain>/api/auth/callback/google
#   Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# (both can be registered on the same OAuth client -- add both redirect URIs)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional access gate. Comma-separated list of allowed Google emails and/or
# GitHub usernames (case-insensitive). Leave empty/unset to allow ANY GitHub
# or Google account to sign in (today's demo default). Set this in Vercel's
# Project -> Settings -> Environment Variables to restrict production too.
# Example: AUTH_ALLOWED_USERS=jane@company.com,jane-gh-username
AUTH_ALLOWED_USERS=
