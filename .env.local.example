# Copy this file to .env.local for local development (never commit .env.local
# itself -- it's already covered by .gitignore's ".env*" rule).
#
# In production (Vercel), set these same three values under
# Project -> Settings -> Environment Variables instead of a file.

# Generate with: npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=

# From a GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:            https://<your-vercel-domain>
#   Authorization callback:  https://<your-vercel-domain>/api/auth/callback/github
# For local dev, register a SEPARATE OAuth App with:
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
